# NB: max-age for /assets/* er kun nettleserens TTL. Cloudflare-kanten cacher i
# tillegg etter sonens Browser Cache TTL (4 t) og bryr seg ikke om verdien her.
# CSS, JS og ikoner får ?v=<innholdshash> av scripts/oppdater-versjoner.py.
# Bilder har ingen hash — endrer du et bilde, gi det nytt filnavn.
/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=3600
